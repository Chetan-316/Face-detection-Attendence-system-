{
  "name": "pravahax-face-recognition-attendance",
  "version": "1.0.0",
  "description": "PRAVAHAx Face Recognition Hostel Attendance & Resident Movement System - Foundation Prototype",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build --prefix client",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "npm run build --prefix client",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:client": "npm run dev --prefix client",
    "seed": "tsx prisma/seed.ts",
    "seed:safe": "tsx scripts/safe-seed.ts",
    "test": "vitest run",
    "test:server": "vitest run",
    "test:client": "npm run test --prefix client",
    "test:all": "vitest run && npm run test --prefix client",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "hostel",
    "attendance",
    "movement-tracking",
    "face-recognition-foundation",
    "postgresql"
  ],
  "author": "PRAVAHAx Engineering",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
