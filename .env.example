# ==============================================================================
# PRAVAHAx Configuration Checklist (.env.example)
# Use this template for local development and pilot deployment.
# NEVER commit real passwords or production secrets to source control.
# ==============================================================================

# Database Settings
DATABASE_URL="postgresql://postgres:CHANGE_THIS_PASSWORD@localhost:5433/pravahax_db?schema=public"
TEST_DATABASE_URL="postgresql://postgres:CHANGE_THIS_PASSWORD@localhost:5433/pravahax_test_db?schema=public"

# Environment & Server Settings
NODE_ENV="production"
PORT=3000
TIMEZONE="Asia/Kolkata"

# Authentication & Security
# Must be a cryptographically strong secret at least 32 characters in production.
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters_long"

# CORS Origin (REQUIRED in production - wildcard '*' is strictly rejected by startup guards)
# Comma-separated list of explicit trusted frontend origins. Never use '*' in production.
CORS_ORIGIN="https://attendance.example.com,https://admin.example.com"

# Biometrics & Face Models
# In production, BIOMETRIC_MOCK must remain false.
BIOMETRIC_MOCK="false"

# Active engine:
#   legacy          = YuNet + SFace (128-D)
#   scrfd_adaface   = SCRFD 2.5G KPS + AdaFace IR50 (512-D)
#
# IMPORTANT: SCRFD/AdaFace model files are not bundled automatically because
# model/checkpoint rights may differ from source-code licenses. Supply only
# model artifacts that your organization is authorized to deploy.
BIOMETRIC_ENGINE="legacy"

# Python / model directory
# PYTHON_BIN="python3"
# MODELS_DIR="./models"

# SCRFD 2.5G KPS operator-supplied model
# SCRFD_MODEL_PATH="./models/scrfd_2.5g_kps.onnx"
# SCRFD_MODEL_URL="https://approved-model-host.example/scrfd_2.5g_kps.onnx"
# SCRFD_MODEL_SHA256=""
# SCRFD_MODEL_VERSION="2.5G-KPS"
# SCRFD_MODEL_LICENSE="Commercial license / internal trained model"
# SCRFD_MODEL_SOURCE="Your approved source"
# SCRFD_SCORE_THRESHOLD="0.45"
# SCRFD_NMS_THRESHOLD="0.40"

# AdaFace IR50 operator-supplied ONNX model
# ADAFACE_MODEL_PATH="./models/adaface_ir50.onnx"
# ADAFACE_MODEL_URL="https://approved-model-host.example/adaface_ir50.onnx"
# ADAFACE_MODEL_SHA256=""
# ADAFACE_MODEL_VERSION="IR50"
# ADAFACE_MODEL_LICENSE="Commercial license / internal trained model"
# ADAFACE_MODEL_SOURCE="Your approved source"
# Match the preprocessing contract of the approved ONNX export.
# CVLFace-style exports are typically RGB; some older/custom exports may require BGR.
# ADAFACE_COLOR_SPACE="RGB"

# SCRFD + AdaFace provisional matching defaults can be overridden after on-site calibration:
# RECOGNITION_MATCH_THRESHOLD="0.45"
# RECOGNITION_UNCERTAIN_THRESHOLD="0.30"
# RECOGNITION_MIN_MARGIN="0.06"

# Never silently use mock recognition if real model initialization fails.
BIOMETRIC_ALLOW_MOCK_FALLBACK="false"

# Media & Camera Processing
# Optional custom path to FFmpeg binary if not in system PATH
# FFMPEG_PATH="C:\\ffmpeg\\bin\\ffmpeg.exe"

# Seed & Maintenance (Local development only - blocked in production)
# SEED_DEFAULT_PASSWORD="replace_with_demo_password_for_local_seed"
# ALLOW_DESTRUCTIVE_SEED="false"

