# PRAVAHAx INSTABOX STAGING - operator template.
# Copy to .env.staging on the host (chmod 600), fill every <PLACEHOLDER>, and never commit the copy.
# This file contains NAMES and PLACEHOLDERS only. Do not put real values here.
# Use STAGING values only: a dedicated staging PostgreSQL database and role, never pravahax_db or production.

# Seed credentials (SAFE_SEED_DATABASE_URL, SEED_DEFAULT_PASSWORD) are NOT stored here.
# The one-time seed run takes them from the shell (see docs/instabox-staging-runbook.md section 7).

# ---- Host / network ----
PUBLIC_HTTP_PORT=8080
# Absolute host directory holding the licensed ONNX artifacts. Mounted read-only at /models.
# Expected filenames: scrfd_2.5g_kps.onnx and adaface_ir50.onnx
MODELS_HOST_DIR=/opt/pravahax/models
CORS_ORIGIN=http://<INSTABOX_HOST_OR_HTTPS_ORIGIN>:8080

# ---- Database (PostgreSQL in the db container; not published to the host) ----
# Owner role: creates schema and runs migrations. Used by the db container and the migrate service only.
STAGING_DB_OWNER_USER=pravahax_owner
STAGING_DB_OWNER_PASSWORD=<OWNER_PASSWORD>
MIGRATION_DATABASE_URL=postgresql://pravahax_owner:<OWNER_PASSWORD>@db:5432/pravahax_staging?schema=public
# Runtime role: created by deploy/staging/bootstrap-runtime-role.sh. No ownership, no TRUNCATE, no audit_logs UPDATE/DELETE.
RUNTIME_DB_ROLE=pravahax_app
RUNTIME_DB_PASSWORD=<RUNTIME_PASSWORD>
RUNTIME_DATABASE_URL=postgresql://pravahax_app:<RUNTIME_PASSWORD>@db:5432/pravahax_staging?schema=public

# ---- Application secrets ----
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=<GENERATE_RANDOM_SECRET>

# ---- Biometric models (operator-supplied, licensed for use) ----
SCRFD_MODEL_SHA256=<SHA256_OF_scrfd_2.5g_kps.onnx>
ADAFACE_MODEL_SHA256=<SHA256_OF_adaface_ir50.onnx>
# Must match the preprocessing contract of the approved AdaFace ONNX export: RGB or BGR.
ADAFACE_COLOR_SPACE=<RGB_OR_BGR>

# ---- Recognition tuning (provisional defaults; on-site calibration required before production) ----
RECOGNITION_MATCH_THRESHOLD=0.45
RECOGNITION_UNCERTAIN_THRESHOLD=0.30
RECOGNITION_MIN_MARGIN=0.06
RECOGNITION_MAX_FPS=5
RECOGNITION_COOLDOWN_MS=8000
MOVEMENT_AUTOMATION_ENABLED=true
